# Discord
DISCORD_BOT_TOKEN=                              # discord.com/developers/applications -> Bot -> Reset Token
DISCORD_APPLICATION_ID=                         # gleiches Application -> General Information
DISCORD_GUILD_ID=                               # rechtsklick auf Server -> Server-ID kopieren (Developer Mode an)
DISCORD_WEBHOOK_DAILY_PULSE=
DISCORD_WEBHOOK_EVENING_DEEP=
DISCORD_WEBHOOK_FRIDAY_REPORT=
DISCORD_WEBHOOK_TRENDS=
DISCORD_WEBHOOK_REGULATION=
DISCORD_WEBHOOK_TRIGGERS=
DISCORD_WEBHOOK_BOT_COMMANDS=
DISCORD_USER_ID_LUKE=                           # fuer @-Mentions in Trigger-Watch

# Anthropic-Auth fuer claude-CLI in den Routinen (systemd-Timer-Sandbox).
# Eines der beiden Felder ausfuellen:
#   - CLAUDE_CODE_OAUTH_TOKEN: Long-lived Token aus 'claude setup-token' (Subscription)
#   - ANTHROPIC_API_KEY: API-Key aus console.anthropic.com (Pay-as-you-go)
CLAUDE_CODE_OAUTH_TOKEN=                        # claude setup-token (lokal) -> hier eintragen
# ANTHROPIC_API_KEY=                            # alternativ: API-Key (sk-ant-api...)

# GitHub (zentria-intel-Repo)
GITHUB_PAT=                                     # PAT mit repo-Scope, fuer Bot-Pushes
GITHUB_USER_EMAIL=                              # Bot-Commit-Identity
GITHUB_USER_NAME=zentria-intel-bot

# Embeddings (self-hosted, default: Ollama auf Hetzner localhost)
EMBEDDINGS_ENDPOINT=http://localhost:11434/api/embeddings
EMBEDDINGS_MODEL=bge-m3

# Headless-Chromium (self-hosted Docker auf Hetzner)
PLAYWRIGHT_SERVICE_URL=http://localhost:3001    # Container-Endpoint fuer Scrape-Requests

# Reddit OAuth Application-Only (Client-Credentials Flow).
# Public-JSON-Endpoint wird seit 2023 mit 403 geblockt, deshalb OAuth Pflicht.
#
# Setup:
#   1. Reddit-Account anlegen/einloggen, dann reddit.com/prefs/apps -> "Create another app"
#   2. Type: "script", name: "zentria-intel", redirect URI: http://localhost:8080
#   3. CLIENT_ID = String unter "personal use script" (14 Zeichen)
#   4. CLIENT_SECRET = String hinter "secret" (27 Zeichen)
#   5. REDDIT_USER_AGENT auf eigenen Reddit-Username anpassen (ohne /u/-Prefix-Match Reddit blockt)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=zentria-intel/0.1 (by /u/zentria-bot)

# ProductHunt (Free Tier Developer-Token)
PRODUCTHUNT_DEVELOPER_TOKEN=

# Hetzner-SSH-Trigger (von Routine aus, falls Routine SSH-Aufrufe macht)
HETZNER_HOST=178.104.38.195
HETZNER_USER=deploy
HETZNER_KEY_PATH=~/.ssh/hetzner_kmuhub
